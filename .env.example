# ============================================================
# AgroGuard IA — variáveis de ambiente (Sprints 2–4)
# Copie para .env:   cp .env.example .env
# O arquivo .env real está no .gitignore (não é versionado).
# ============================================================

# --- PostgreSQL (usado pelo docker-compose e pelos scripts Python) ---
POSTGRES_USER=agroguard
POSTGRES_PASSWORD=agroguard
POSTGRES_DB=agroguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# String de conexão derivada (os scripts montam automaticamente a partir das
# variáveis acima; defina DATABASE_URL apenas se quiser sobrescrever).
# DATABASE_URL=postgresql+psycopg2://agroguard:agroguard@localhost:5432/agroguard

# --- pgAdmin (opcional, profile "tools") ---
PGADMIN_EMAIL=admin@agroguard.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- API (Sprint 3) ---
# Porta da API (8000 costuma estar ocupada por outros serviços locais)
API_PORT=8001
# Chaves de acesso: lista "kid:papel:segredo" separada por vírgula.
# Papéis: dispositivo | operador | gestor | seguradora | admin
# TROQUE os segredos fora do ambiente de desenvolvimento.
AGROGUARD_API_KEYS=sim01:dispositivo:dev-dispositivo-troque-me,ope01:operador:dev-operador-troque-me,ges01:gestor:dev-gestor-troque-me,seg01:seguradora:dev-seguradora-troque-me,adm01:admin:dev-admin-troque-me
# Limite de requisições por minuto por chave (proteção da API)
RATE_LIMIT_POR_MIN=120
# Pasta dos artefatos do modelo (opcional; padrão ml/models)
# AGROGUARD_MODELS_DIR=ml/models
